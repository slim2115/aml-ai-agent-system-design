<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ToBe" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js" exporterVersion="18.0.0">
  <bpmn:process id="Process_ToBe" name="AML Investigation To-Be (AI Copilot)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ToBe">
      <bpmn:lane id="Lane_Core" name="Core / Alert Systems">
        <bpmn:flowNodeRef>Start_ToBe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendIncident</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ManualQueue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Manual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExportToCaseMgmt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Closed_ToBe</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AI" name="AML / Anti-Fraud Copilot (AI) — Read-Only [BR-07]">
        <bpmn:flowNodeRef>Task_Deserialize</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DataValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SemanticSearch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LogReasoning</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateDraft</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InitiateReject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Operator_ToBe" name="AML Operator (1st Line)">
        <bpmn:flowNodeRef>Task_GetWorkspace</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateHuman</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_NeedsCorrection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EditReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApproveReport</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_ToBe" name="Поступил новый алерт">
      <bpmn:outgoing>F_ToBe_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_SendIncident" name="Отправить ID инцидента и данные (JSON) в Copilot">
      <bpmn:incoming>F_ToBe_1</bpmn:incoming>
      <bpmn:outgoing>F_ToBe_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ManualQueue" name="Передать кейс в очередь ручной обработки">
      <bpmn:incoming>F_ToBe_9</bpmn:incoming>
      <bpmn:outgoing>F_ToBe_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Manual" name="Кейс передан в ручную очередь">
      <bpmn:incoming>F_ToBe_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_ExportToCaseMgmt" name="Экспортировать отчет в Систему ведения кейсов (автоматически)">
      <bpmn:incoming>F_ToBe_17</bpmn:incoming>
      <bpmn:outgoing>F_ToBe_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Closed_ToBe" name="Кейс закрыт">
      <bpmn:incoming>F_ToBe_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Deserialize" name="Десериализовать и валидировать входную схему">
      <bpmn:incoming>F_ToBe_2</bpmn:incoming>
      <bpmn:outgoing>F_ToBe_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_DataValid" name="Данные полные и однозначные? (BRULE-03)">
      <bpmn:incoming>F_ToBe_3</bpmn:incoming>
      <bpmn:outgoing>F_ToBe_4</bpmn:outgoing>
      <bpmn:outgoing>F_ToBe_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_SemanticSearch" name="Выполнить семантический поиск по базе регламентов (Read-Only, RAG)">
      <bpmn:incoming>F_ToBe_4</bpmn:incoming>
      <bpmn:outgoing>F_ToBe_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_LogReasoning" name="Логировать цепочку рассуждений (Audit Trail)">
      <bpmn:incoming>F_ToBe_6</bpmn:incoming>
      <bpmn:outgoing>F_ToBe_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_GenerateDraft" name="Сгенерировать черновик отчета (JSON/Markdown) со ссылками на источники [BR-04] и выделением фактов [BR-06]">
      <bpmn:incoming>F_ToBe_7</bpmn:incoming>
      <bpmn:outgoing>F_ToBe_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_InitiateReject" name="Инициировать явный отказ (без генерации гипотез) [BRULE-03]">
      <bpmn:incoming>F_ToBe_5</bpmn:incoming>
      <bpmn:outgoing>F_ToBe_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_GetWorkspace" name="Получить рабочую область с AI-черновиком">
      <bpmn:incoming>F_ToBe_8</bpmn:incoming>
      <bpmn:outgoing>F_ToBe_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ValidateHuman" name="Валидировать факты и ссылки (Human-in-the-Loop) [BRULE-01]">
      <bpmn:incoming>F_ToBe_11</bpmn:incoming>
      <bpmn:outgoing>F_ToBe_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_NeedsCorrection" name="Требуется корректировка?">
      <bpmn:incoming>F_ToBe_12</bpmn:incoming>
      <bpmn:outgoing>F_ToBe_13</bpmn:outgoing>
      <bpmn:outgoing>F_ToBe_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_EditReport" name="Скорректировать отчет вручную">
      <bpmn:incoming>F_ToBe_13</bpmn:incoming>
      <bpmn:outgoing>F_ToBe_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Merge">
      <bpmn:incoming>F_ToBe_14</bpmn:incoming>
      <bpmn:incoming>F_ToBe_15</bpmn:incoming>
      <bpmn:outgoing>F_ToBe_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ApproveReport" name="Одобрить и подписать отчет (только человек)">
      <bpmn:incoming>F_ToBe_16</bpmn:incoming>
      <bpmn:outgoing>F_ToBe_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="F_ToBe_1" sourceRef="Start_ToBe" targetRef="Task_SendIncident" />
    <bpmn:sequenceFlow id="F_ToBe_2" sourceRef="Task_SendIncident" targetRef="Task_Deserialize" />
    <bpmn:sequenceFlow id="F_ToBe_3" sourceRef="Task_Deserialize" targetRef="Gateway_DataValid" />
    <bpmn:sequenceFlow id="F_ToBe_4" name="Да" sourceRef="Gateway_DataValid" targetRef="Task_SemanticSearch" />
    <bpmn:sequenceFlow id="F_ToBe_5" name="Нет" sourceRef="Gateway_DataValid" targetRef="Task_InitiateReject" />
    <bpmn:sequenceFlow id="F_ToBe_6" sourceRef="Task_SemanticSearch" targetRef="Task_LogReasoning" />
    <bpmn:sequenceFlow id="F_ToBe_7" sourceRef="Task_LogReasoning" targetRef="Task_GenerateDraft" />
    <bpmn:sequenceFlow id="F_ToBe_8" sourceRef="Task_GenerateDraft" targetRef="Task_GetWorkspace" />
    <bpmn:sequenceFlow id="F_ToBe_9" sourceRef="Task_InitiateReject" targetRef="Task_ManualQueue" />
    <bpmn:sequenceFlow id="F_ToBe_10" sourceRef="Task_ManualQueue" targetRef="End_Manual" />
    <bpmn:sequenceFlow id="F_ToBe_11" sourceRef="Task_GetWorkspace" targetRef="Task_ValidateHuman" />
    <bpmn:sequenceFlow id="F_ToBe_12" sourceRef="Task_ValidateHuman" targetRef="Gateway_NeedsCorrection" />
    <bpmn:sequenceFlow id="F_ToBe_13" name="Да" sourceRef="Gateway_NeedsCorrection" targetRef="Task_EditReport" />
    <bpmn:sequenceFlow id="F_ToBe_14" name="Нет" sourceRef="Gateway_NeedsCorrection" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="F_ToBe_15" sourceRef="Task_EditReport" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="F_ToBe_16" sourceRef="Gateway_Merge" targetRef="Task_ApproveReport" />
    <bpmn:sequenceFlow id="F_ToBe_17" sourceRef="Task_ApproveReport" targetRef="Task_ExportToCaseMgmt" />
    <bpmn:sequenceFlow id="F_ToBe_18" sourceRef="Task_ExportToCaseMgmt" targetRef="End_Closed_ToBe" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ToBe">
    <bpmndi:BPMNPlane id="BPMNPlane_ToBe" bpmnElement="Process_ToBe">
      <bpmndi:BPMNShape id="Lane_Operator_ToBe_di" bpmnElement="Lane_Operator_ToBe" isHorizontal="true">
        <dc:Bounds x="100" y="450" width="2700" height="250" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_AI_di" bpmnElement="Lane_AI" isHorizontal="true">
        <dc:Bounds x="100" y="230" width="2700" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Core_di" bpmnElement="Lane_Core" isHorizontal="true">
        <dc:Bounds x="100" y="50" width="2700" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_ToBe_di" bpmnElement="Start_ToBe">
        <dc:Bounds x="160" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="138" y="165" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendIncident_di" bpmnElement="Task_SendIncident">
        <dc:Bounds x="260" y="100" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ManualQueue_di" bpmnElement="Task_ManualQueue">
        <dc:Bounds x="1260" y="100" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Manual_di" bpmnElement="End_Manual">
        <dc:Bounds x="1500" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1470" y="165" width="100" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ExportToCaseMgmt_di" bpmnElement="Task_ExportToCaseMgmt">
        <dc:Bounds x="2370" y="100" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Closed_ToBe_di" bpmnElement="End_Closed_ToBe">
        <dc:Bounds x="2610" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2595" y="165" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_Deserialize_di" bpmnElement="Task_Deserialize">
        <dc:Bounds x="260" y="300" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_DataValid_di" bpmnElement="Gateway_DataValid" isMarkerVisible="true">
        <dc:Bounds x="500" y="315" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="445" y="278" width="160" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SemanticSearch_di" bpmnElement="Task_SemanticSearch">
        <dc:Bounds x="620" y="300" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_LogReasoning_di" bpmnElement="Task_LogReasoning">
        <dc:Bounds x="840" y="300" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GenerateDraft_di" bpmnElement="Task_GenerateDraft">
        <dc:Bounds x="1060" y="300" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_InitiateReject_di" bpmnElement="Task_InitiateReject">
        <dc:Bounds x="620" y="400" width="200" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GetWorkspace_di" bpmnElement="Task_GetWorkspace">
        <dc:Bounds x="1340" y="540" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ValidateHuman_di" bpmnElement="Task_ValidateHuman">
        <dc:Bounds x="1560" y="540" width="200" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_NeedsCorrection_di" bpmnElement="Gateway_NeedsCorrection" isMarkerVisible="true">
        <dc:Bounds x="1800" y="555" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1739" y="496" width="82" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EditReport_di" bpmnElement="Task_EditReport">
        <dc:Bounds x="1900" y="470" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Merge_di" bpmnElement="Gateway_Merge" isMarkerVisible="true">
        <dc:Bounds x="2050" y="600" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ApproveReport_di" bpmnElement="Task_ApproveReport">
        <dc:Bounds x="2150" y="585" width="180" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F_ToBe_1_di" bpmnElement="F_ToBe_1">
        <di:waypoint x="196" y="140" />
        <di:waypoint x="260" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_ToBe_2_di" bpmnElement="F_ToBe_2">
        <di:waypoint x="350" y="180" />
        <di:waypoint x="350" y="300" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_ToBe_3_di" bpmnElement="F_ToBe_3">
        <di:waypoint x="440" y="340" />
        <di:waypoint x="500" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_ToBe_4_di" bpmnElement="F_ToBe_4">
        <di:waypoint x="550" y="340" />
        <di:waypoint x="620" y="340" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="575" y="320" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_ToBe_5_di" bpmnElement="F_ToBe_5">
        <di:waypoint x="525" y="365" />
        <di:waypoint x="525" y="440" />
        <di:waypoint x="620" y="440" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="535" y="400" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_ToBe_6_di" bpmnElement="F_ToBe_6">
        <di:waypoint x="800" y="340" />
        <di:waypoint x="840" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_ToBe_7_di" bpmnElement="F_ToBe_7">
        <di:waypoint x="1020" y="340" />
        <di:waypoint x="1060" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_ToBe_8_di" bpmnElement="F_ToBe_8">
        <di:waypoint x="1170" y="380" />
        <di:waypoint x="1170" y="580" />
        <di:waypoint x="1340" y="580" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_ToBe_9_di" bpmnElement="F_ToBe_9">
        <di:waypoint x="820" y="440" />
        <di:waypoint x="1350" y="440" />
        <di:waypoint x="1350" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_ToBe_10_di" bpmnElement="F_ToBe_10">
        <di:waypoint x="1440" y="140" />
        <di:waypoint x="1500" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_ToBe_11_di" bpmnElement="F_ToBe_11">
        <di:waypoint x="1520" y="580" />
        <di:waypoint x="1560" y="580" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_ToBe_12_di" bpmnElement="F_ToBe_12">
        <di:waypoint x="1760" y="580" />
        <di:waypoint x="1800" y="580" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_ToBe_13_di" bpmnElement="F_ToBe_13">
        <di:waypoint x="1825" y="555" />
        <di:waypoint x="1825" y="510" />
        <di:waypoint x="1900" y="510" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1835" y="525" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_ToBe_14_di" bpmnElement="F_ToBe_14">
        <di:waypoint x="1825" y="605" />
        <di:waypoint x="1825" y="625" />
        <di:waypoint x="2050" y="625" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1835" y="610" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_ToBe_15_di" bpmnElement="F_ToBe_15">
        <di:waypoint x="1990" y="550" />
        <di:waypoint x="1990" y="625" />
        <di:waypoint x="2050" y="625" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_ToBe_16_di" bpmnElement="F_ToBe_16">
        <di:waypoint x="2100" y="625" />
        <di:waypoint x="2150" y="625" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_ToBe_17_di" bpmnElement="F_ToBe_17">
        <di:waypoint x="2330" y="625" />
        <di:waypoint x="2460" y="625" />
        <di:waypoint x="2460" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_ToBe_18_di" bpmnElement="F_ToBe_18">
        <di:waypoint x="2550" y="140" />
        <di:waypoint x="2610" y="140" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
