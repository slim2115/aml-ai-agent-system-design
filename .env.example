# Reference only; Enter-LocalEnvironment.ps1 provides absolute paths.
# No .env is created or auto-loaded by the rebuild launcher.
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL_NAME=qwen2.5:14b
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL_PATH=./var/models/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MANIFEST_PATH=./var/models/paraphrase-multilingual-MiniLM-L12-v2.manifest.json
CHROMA_PERSIST_DIR=./var/chroma
KNOWLEDGE_BASE_COLLECTION=aml_compliance_rules_rebuild
SYNTHETIC_DATA_DIR=./data/synthetic
FAITHFULNESS_THRESHOLD=0.90
SCHEMA_MATCH_THRESHOLD=1.0
TRACEABILITY_THRESHOLD=1.0
REFUSAL_CORRECTNESS_THRESHOLD=0.95
RAG_RECALL_THRESHOLD=1.0
RAG_PRECISION_THRESHOLD=1.0
# Legacy per-request timeout; a complete job deadline is not implemented yet.
GENERATION_TIMEOUT_SEC=180
