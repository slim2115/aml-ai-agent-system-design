# === LLM (локальная Ollama, ADR-0005) ===
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL_NAME=qwen2.5:14b
EMBEDDING_MODEL_NAME=nomic-embed-text

# === Векторная БД (ChromaDB) ===
CHROMA_PERSIST_DIR=./data/chroma
KNOWLEDGE_BASE_COLLECTION=aml_compliance_rules

# === Синтетические данные ===
SYNTHETIC_DATA_DIR=./data/synthetic

# === Пороги метрик (Evaluation Plan, раздел 3) ===
FAITHFULNESS_THRESHOLD=0.90
SCHEMA_MATCH_THRESHOLD=1.0
TRACEABILITY_THRESHOLD=1.0
REFUSAL_CORRECTNESS_THRESHOLD=0.95

# === Производительность (NFR-07) ===
GENERATION_TIMEOUT_SEC=600

# Порог M-07 RAG Recall: доля извлечённых RAG правил, попавших в applicable_rules.
# Дефолт 0.5 допускает LLM-недетерминизм; поднять до 0.7 после усиления промпта.
RAG_RECALL_THRESHOLD=0.50